# URL проекта Supabase из Project Settings → API
SUPABASE_URL=
# Только серверный sb_secret_… или legacy service_role; не публичный anon
SUPABASE_SECRET_KEY=
# Токен от @BotFather, никогда не отправляйте его в чат
TELEGRAM_BOT_TOKEN=
# Числовой ID получателя, после нажатия Start у бота
TELEGRAM_CHAT_ID=
# Окончательный HTTPS-адрес сайта без пути; затем пересобрать
SITE_URL=
# Установить true только после утверждения политики, заполнения контактов и проверки каналов
LEAD_INTAKE_ENABLED=false
